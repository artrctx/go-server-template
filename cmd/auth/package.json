{
  "name": "templ-auth",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "generate": "dotenv -e .env -- pnpm dlx @better-auth/cli@latest generate --config ./src/lib/auth/server.ts --output ./src/lib/auth/schema.ts && drizzle-kit generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@better-auth/expo": "^1.6.26",
    "@hono/node-server": "^2.1.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@t3-oss/env-core": "^0.13.11",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "pg": "^8.22.0",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.10",
    "typescript": "^6.0.3"
  }
}
